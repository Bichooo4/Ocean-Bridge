# Copy this file to .env.local and fill in your values.
# All three variables are required — the app will not start without them.
#
# Find these values in your Supabase project:
#   Settings → API → Project URL / Project API keys

# Your Supabase project URL (safe to expose — used on client + server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous/public key (safe to expose — RLS is your access control)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase service-role key — KEEP THIS SECRET
# Used ONLY in server-side API routes (lib/supabase/admin.ts)
# Never prefix with NEXT_PUBLIC_ — that would expose it to the browser
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
